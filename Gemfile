# Gemfile
# Run `bundle install` then `bundle exec jekyll serve` to start locally.

source "https://rubygems.org"

# Locks Jekyll and all plugins to versions compatible with GitHub Pages
gem "github-pages", group: :jekyll_plugins

group :jekyll_plugins do
  gem "jekyll-feed"
  gem "jekyll-seo-tag"
end

# Required on Windows for watching file changes
gem "wdm", "~> 0.1.1", platforms: :mingw, :x64_mingw, :mswin

# Required for Ruby 3.x compatibility
gem "webrick", "~> 1.7"
